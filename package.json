{
  "name": "@deepseek-ai/dsh-client-ui-liquid-glass",
  "description": "Liquid Glass & Live Wallpaper: a physical Snell-refraction fluid glassmorphism theme and dynamic wallpaper engine for DeepSeek Harness (web profile and desktop app)",
  "version": "2.0.3",
  "homepage": "https://github.com/Rainpomelo/dsh-liquid-glass-theme#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rainpomelo/dsh-liquid-glass-theme.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-store",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-model-selection"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "node build.mjs",
    "watch": "node build.mjs --watch",
    "test": "node --test tests/*.test.mjs"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/dsh-client-locale": "^0.1.0-rc.5 || ^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-store": "^0.1.0-rc.5 || ^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-runtime": "^0.1.0-rc.5 || ^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.0-rc.5 || ^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.0-rc.5 || ^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-settings-plugins": "^0.1.0-rc.5 || ^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.0-rc.5 || ^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-theme": "^0.1.0-rc.5 || ^0.2.0-rc.2",
    "@deepseek-ai/dsh-invariants": "^0.1.0-rc.5 || ^0.2.0-rc.2",
    "@deepseek-ai/cordis": "^4.0.1",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.9",
    "lightningcss": "^1.29.2",
    "@testing-library/react": "^16.1.0",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "assets/**/*",
    "cordis.patch.yml"
  ]
}
