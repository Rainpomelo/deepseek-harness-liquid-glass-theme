rack{background:#0006;border:1px solid #ffffff26;border-radius:999px;width:28px;height:16px;transition:background .18s,border-color .18s;position:relative}.YQXauG_toggle[aria-pressed=true] .YQXauG_switchTrack{background:#38bdf8;border-color:#7dd3fc;box-shadow:0 0 8px #38bdf899}.YQXauG_switchThumb{background:#fff;border-radius:50%;width:12px;height:12px;transition:transform .18s cubic-bezier(.16,1,.3,1);position:absolute;top:1px;left:1px;box-shadow:0 1px 3px #0006}.YQXauG_toggle[aria-pressed=true] .YQXauG_switchThumb{background:#fff;transform:translate(12px)}.YQXauG_switchLabel{letter-spacing:.02em;font-size:12px}.YQXauG_configBtn{color:#ffffffd9;cursor:pointer;user-select:none;background:#ffffff0f;border:1px solid #ffffff2e;border-radius:10px;justify-content:center;align-items:center;height:32px;padding:0 12px;font-size:12px;font-weight:500;transition:all .14s;display:inline-flex}.YQXauG_configBtn:hover{color:#fff;background:#ffffff24;border-color:#ffffff59;transform:translateY(-1px)}";
